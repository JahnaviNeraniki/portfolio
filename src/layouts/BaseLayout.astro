---
import "../styles/global.css";
import displayFont from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";
import Nav from "../components/ui/Nav.astro";
import Footer from "../components/ui/Footer.astro";
import { copy, profile } from "../data/profile";
import { site } from "../data/site";

interface Props {
  /** Full page title, e.g. "DocuMind · Jane Doe" */
  title: string;
  description: string;
  type?: "website" | "article";
}

const { title, description, type = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Set the theme before first paint so there is no flash. Mirrors src/lib/theme.ts. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let pref = "system";
        try {
          const stored = localStorage.getItem("theme");
          if (["system", "light", "dark", "matrix"].includes(stored)) pref = stored;
        } catch {
          /* storage blocked */
        }
        const dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = pref === "system" ? (dark ? "dark" : "light") : pref;
        root.dataset.theme = theme;
        root.dataset.themePref = pref;
        root.style.colorScheme = theme === "light" ? "light" : "dark";
        root.classList.add("js");
      })();
    </script>
    {site.goatcounterCode && (
      <script
        is:inline
        async
        data-goatcounter={`https://${site.goatcounterCode}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"
      />
    )}
    <slot name="head" />
  </head>
  <body class="bg-bg text-text">
    <div id="top"></div>
    <a href="#main" class="skip-link">
      {copy.skipLink}
    </a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
