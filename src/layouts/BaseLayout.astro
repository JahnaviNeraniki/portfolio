---
import "../styles/global.css";
import displayFont from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import Nav from "../components/ui/Nav.astro";
import Footer from "../components/ui/Footer.astro";
import Terminal from "../components/islands/Terminal";
import CommandPalette from "../components/islands/CommandPalette";
import EasterEggs from "../components/islands/EasterEggs";
import { copy, profile } from "../data/profile";
import { site } from "../data/site";
import { getCollection } from "astro:content";
import { getOgPages, ogKey } from "../lib/og";
import { getProjects } from "../lib/projects";
import { getHomeSections, sourceUrl } from "../lib/sections";
import { withBase, withoutBase } from "../lib/url";

interface Props {
  /** Full page title, e.g. "DocuMind · Jane Doe" */
  title: string;
  description: string;
  type?: "website" | "article";
  /** Set false on /terminal, which shows the terminal full screen instead of as an overlay */
  terminalOverlay?: boolean;
}

const { title, description, type = "website", terminalOverlay = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Social preview image for this page; pages without their own (e.g. 404) use the home image.
const ogPages = await getOgPages();
const key = ogKey(withoutBase(Astro.url.pathname));
const ogImage = new URL(withBase(`/og/${key in ogPages ? key : "index"}.png`), Astro.site).href;
const hasPosts = (await getCollection("posts", (post) => !post.data.draft)).length > 0;

// Data for the terminal and command palette islands.
const projects = (await getProjects()).map((project) => ({
  slug: project.id,
  title: project.data.title,
  summary: project.data.summary,
  tech: project.data.tech,
}));
const paletteSource = {
  sections: await getHomeSections(),
  projects,
  pages: [
    { href: "/uses", label: copy.uses.title },
    { href: "/terminal", label: copy.terminal.pageTitle },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    {hasPosts && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={profile.name}
        href={withBase("/rss.xml")}
      />
    )}
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Set the theme before first paint so there is no flash. Mirrors src/lib/theme.ts. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let pref = "dark"; // DEFAULT_THEME in src/lib/theme.ts
        try {
          const stored = localStorage.getItem("theme");
          if (["system", "light", "dark", "matrix"].includes(stored)) pref = stored;
        } catch {
          /* storage blocked */
        }
        const dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = pref === "system" ? (dark ? "dark" : "light") : pref;
        root.dataset.theme = theme;
        root.dataset.themePref = pref;
        root.style.colorScheme = theme === "light" ? "light" : "dark";
        root.classList.add("js");
      })();
    </script>
    {site.goatcounterCode && (
      <script
        is:inline
        async
        data-goatcounter={`https://${site.goatcounterCode}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"
      />
    )}
    <slot name="head" />
  </head>
  <body class="bg-bg text-text">
    <div id="top"></div>
    <a href="#main" class="skip-link">
      {copy.skipLink}
    </a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {terminalOverlay && <Terminal client:idle projects={projects} />}
    <CommandPalette client:idle source={paletteSource} />
    <EasterEggs client:idle sourceUrl={sourceUrl} />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
