---
import type { CollectionEntry } from "astro:content";
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { copy } from "../../data/profile";
import { withBase } from "../../lib/url";

interface Props {
  /** Published posts, newest first */
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<section id="writing" class="section container-page reveal" aria-labelledby="writing-title">
  <SectionHeading id="writing" title={copy.sections.writing} />

  <ul class="mt-10 flex flex-col gap-4">
    {posts.map((post) => (
      <li>
        <Card hover class="p-5">
          <p class="text-mono text-muted">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>
              {post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </p>
          <h3 class="mt-1">
            <a
              href={withBase(`/posts/${post.id}`)}
              class="text-text no-underline hover:text-accent"
            >
              {post.data.title}
            </a>
          </h3>
          <p class="mt-2 text-muted">{post.data.summary}</p>
        </Card>
      </li>
    ))}
  </ul>
</section>
