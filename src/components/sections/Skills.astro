---
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Tag from "../ui/Tag.astro";
import { copy, profile } from "../../data/profile";
---

<section id="skills" class="section container-page reveal" aria-labelledby="skills-title">
  <SectionHeading id="skills" title={copy.sections.skills} />

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {profile.skills.map((skill) => (
      <Card class="p-5">
        <h3 class="text-mono font-semibold text-accent">{skill.group}</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {skill.items.map((name) => (
            <li>
              <Tag name={name} icon />
            </li>
          ))}
        </ul>
      </Card>
    ))}
  </div>
</section>
