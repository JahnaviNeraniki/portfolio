---
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Tag from "../ui/Tag.astro";
import { copy, profile } from "../../data/profile";
import { formatMonth } from "../../lib/format";

interface Props {
  index: number;
}

const { index } = Astro.props;
const { education = [], certifications = [] } = profile;
---

<section id="experience" class="section container-page reveal" aria-labelledby="experience-title">
  <SectionHeading index={index} id="experience" title={copy.sections.experience} />

  <div class="timeline relative mt-10">
    <span class="timeline-line" aria-hidden="true"></span>
    <ol class="flex flex-col gap-10">
      {profile.experience.map((job) => (
        <li class="timeline-item relative pl-8 md:pl-10">
          <span class="timeline-dot" aria-hidden="true" />
          <p class="text-mono text-muted">
            <time>{formatMonth(job.start)}</time> – <time>{formatMonth(job.end)}</time>
            {job.location && <span> · {job.location}</span>}
          </p>
          <h3 class="mt-1">
            {job.title} <span class="text-muted">@ {job.company}</span>
          </h3>
          <ul class="mt-3 flex list-disc flex-col gap-1 pl-5 marker:text-muted">
            {job.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tech used">
            {job.tech.map((name) => (
              <li>
                <Tag name={name} />
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>

  {(education.length > 0 || certifications.length > 0) && (
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {education.length > 0 && (
        <Card class="p-5">
          <h3 class="text-mono font-semibold text-accent">{copy.experience.education}</h3>
          <ul class="mt-4 flex flex-col gap-4">
            {education.map((entry) => (
              <li>
                <p class="font-semibold">{entry.degree}</p>
                <p class="text-muted">{entry.school}</p>
                <p class="text-mono text-muted">{entry.year}</p>
              </li>
            ))}
          </ul>
        </Card>
      )}
      {certifications.length > 0 && (
        <Card class="p-5">
          <h3 class="text-mono font-semibold text-accent">{copy.experience.certifications}</h3>
          <ul class="mt-4 flex flex-col gap-4">
            {certifications.map((cert) => (
              <li>
                <p class="font-semibold">
                  {cert.url ? (
                    <a href={cert.url} rel="noopener">
                      {cert.name}
                    </a>
                  ) : (
                    cert.name
                  )}
                </p>
                <p class="text-mono text-muted">{cert.year}</p>
              </li>
            ))}
          </ul>
        </Card>
      )}
    </div>
  )}
</section>

<style>
  .timeline-line,
  .timeline-line::after {
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 0;
    width: 2px;
    border-radius: 2px;
  }
  .timeline-line {
    background: var(--border);
  }
  /* The accent line that draws itself as you scroll */
  .timeline-line::after {
    content: "";
    left: 0;
    top: 0;
    background: var(--accent);
    transform-origin: top;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline-line::after {
        animation: draw-line linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 60%;
      }
    }
  }
  @keyframes draw-line {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    border: 2px solid var(--accent);
    background: var(--bg);
  }
</style>
