---
import { Download, Mail } from "lucide-react";
import { siGithub } from "simple-icons";
import Button from "../ui/Button.astro";
import { copy, profile } from "../../data/profile";

interface Props {
  /** Title of the featured project, for the "View DocuMind" button */
  featuredTitle: string | undefined;
}

const { featuredTitle } = Astro.props;
---

<section class="hero relative overflow-hidden" aria-labelledby="hero-name">
  <canvas class="star-field absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

  <!-- Floating ringed planet with a small moon in orbit (decorative) -->
  <div class="planet" aria-hidden="true">
    <svg viewBox="0 0 200 200">
      <defs>
        <radialGradient id="planet-fill" cx="35%" cy="30%" r="75%">
          <stop offset="0" stop-color="#c4b5fd"></stop>
          <stop offset="0.55" stop-color="#7c3aed"></stop>
          <stop offset="1" stop-color="#1e1b4b"></stop>
        </radialGradient>
      </defs>
      <ellipse
        cx="100"
        cy="104"
        rx="96"
        ry="22"
        fill="none"
        stroke="#38bdf8"
        stroke-opacity="0.35"
        stroke-width="5"
        transform="rotate(-14 100 100)"
      ></ellipse>
      <circle cx="100" cy="100" r="58" fill="url(#planet-fill)"></circle>
      <path
        d="M43 112 A96 22 0 0 0 157 88"
        fill="none"
        stroke="#38bdf8"
        stroke-opacity="0.85"
        stroke-width="5"
        transform="rotate(-14 100 100)"
      ></path>
      <g class="moon">
        <circle cx="100" cy="14" r="5" fill="#f5f3ff" stroke="#a78bfa" stroke-width="1.5"></circle>
      </g>
    </svg>
  </div>

  <div class="container-page relative flex min-h-[calc(100svh-4rem)] flex-col justify-center py-16">
    <p class="text-mono inline-flex w-fit items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-muted">
      <span class="status-dot" aria-hidden="true"></span>
      {profile.availability}
    </p>

    <h1 id="hero-name" class="text-display mt-6">
      {profile.name}
    </h1>

    <p class="mt-4 font-display text-xl font-semibold text-accent md:text-2xl">
      <span class="sr-only">{profile.headline}</span>
      <span aria-hidden="true" data-typed>
        {profile.headline}
      </span>
    </p>

    <p class="mt-4 text-lg text-muted">{profile.tagline}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      {featuredTitle && (
        <Button href="#featured" variant="primary">
          {`${copy.hero.view} ${featuredTitle}`}
        </Button>
      )}
      <Button href={profile.links.resume} download>
        <Download size={18} aria-hidden="true" />
        {copy.hero.resume}
      </Button>
      <Button href="#contact">{copy.hero.contact}</Button>
    </div>

    <ul class="mt-8 flex gap-2" aria-label="Social links">
      <li>
        <a href={profile.links.github} class="icon-btn" aria-label="GitHub" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d={siGithub.path}></path>
          </svg>
        </a>
      </li>
      <li>
        <a href={profile.links.linkedin} class="icon-btn" aria-label="LinkedIn" rel="noopener">
          <span class="font-mono text-base font-bold" aria-hidden="true">
            in
          </span>
        </a>
      </li>
      <li>
        <a href={`mailto:${profile.email}`} class="icon-btn" aria-label="Email">
          <Mail size={20} aria-hidden="true" />
        </a>
      </li>
    </ul>

    <p class="text-mono mt-auto hidden pt-12 text-muted md:block">
      {copy.hero.hintBefore} <kbd class="rounded border border-border bg-surface px-1.5">`</kbd>{" "}
      {copy.hero.hintAfter}
    </p>
  </div>
</section>

<script>
  import "../../scripts/hero";
</script>

<style>
  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent-2);
  }
  .status-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--accent-2);
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* Blinking caret while the headline types */
  [data-typed].is-typing::after {
    content: "▍";
    margin-left: 2px;
    animation: caret 0.8s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* Fade the stars out towards the bottom so the content stays readable */
  .star-field {
    mask-image: linear-gradient(to bottom, black 55%, transparent);
  }

  .planet {
    position: absolute;
    top: 12%;
    right: max(16px, 6vw);
    width: clamp(120px, 24vw, 280px);
    aspect-ratio: 1;
    pointer-events: none;
    opacity: 0.95;
    animation: float 7s ease-in-out infinite;
  }
  .planet svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .moon {
    transform-origin: 100px 100px;
    animation: orbit 9s linear infinite;
  }
  @keyframes float {
    50% {
      transform: translateY(-12px);
    }
  }
  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }
  /* On phones the planet sits small in the top corner, behind the text */
  @media (max-width: 767px) {
    .planet {
      top: 16px;
      opacity: 0.55;
    }
  }
</style>
