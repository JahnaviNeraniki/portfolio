---
import { ArrowRight } from "lucide-react";
import { siGithub } from "simple-icons";
import Button from "../ui/Button.astro";
import MetricCard from "../ui/MetricCard.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Tag from "../ui/Tag.astro";
import VideoEmbed from "../ui/VideoEmbed.astro";
import { copy } from "../../data/profile";
import type { Project } from "../../lib/projects";

interface Props {
  index: number;
  project: Project;
}

const { index, project } = Astro.props;
const { title, summary, video, poster, metrics, tech, repo } = project.data;
---

<section id="featured" class="section container-page reveal" aria-labelledby="featured-title">
  <SectionHeading index={index} id="featured" title={copy.sections.featured} />

  <article class="card mt-10 p-5 md:p-8">
    <h3 class="text-3xl md:text-4xl">{title}</h3>
    <p class="mt-3 text-muted">{summary}</p>

    <div class="mt-6">
      <VideoEmbed video={video} poster={poster} title={`${title} demo`} />
    </div>

    {metrics.length > 0 && (
      <div class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
        {metrics.map((metric) => (
          <MetricCard label={metric.label} value={metric.value} />
        ))}
      </div>
    )}

    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tech stack">
      {tech.map((name) => (
        <li>
          <Tag name={name} />
        </li>
      ))}
    </ul>

    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={`/projects/${project.id}`} variant="primary">
        {copy.featured.caseStudy}
        <ArrowRight size={18} aria-hidden="true" />
      </Button>
      {repo && (
        <Button href={repo}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d={siGithub.path} />
          </svg>
          {copy.featured.code}
        </Button>
      )}
    </div>
  </article>
</section>
