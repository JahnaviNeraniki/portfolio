---
import ThemeToggle from "../islands/ThemeToggle";
import MobileMenu from "../islands/MobileMenu";
import { copy, profile } from "../../data/profile";
import { navLinks } from "../../lib/nav";
import { initials } from "../../lib/format";
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-md">
  <nav aria-label="Main" class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href="/#top"
      id="monogram"
      class="monogram font-mono text-lg font-bold text-text no-underline"
      aria-label={`${profile.name}, back to top`}
    >
      {initials(profile.name)}
    </a>

    <div class="flex items-center gap-1">
      <ul class="mr-2 hidden items-center gap-1 md:flex">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} data-nav-link={link.id} class="nav-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <button
        type="button"
        class="icon-btn hidden sm:inline-flex"
        data-open-palette
        aria-label="Open command palette (Ctrl+K)"
        title="Command palette (Ctrl+K)"
      >
        <kbd class="font-mono text-xs">⌘K</kbd>
      </button>
      <button
        type="button"
        class="icon-btn"
        data-open-terminal
        aria-label="Open terminal (backtick key)"
        title="Terminal ( ` )"
      >
        <span class="font-mono text-sm font-bold" aria-hidden="true">
          &gt;_
        </span>
      </button>
      <ThemeToggle client:idle />
      <MobileMenu
        client:media="(max-width: 767px)"
        links={navLinks.map(({ href, label }) => ({ href, label }))}
        labels={{ search: copy.nav.search, terminal: copy.nav.terminal }}
      />
    </div>
  </nav>
  <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
</header>

<script>
  import "../../scripts/nav";
</script>

<style>
  .monogram {
    display: inline-block;
    transition: transform 400ms ease-out;
  }
  .monogram::after {
    content: ".";
    color: var(--accent-2);
  }

  .nav-link {
    display: inline-block;
    padding: 6px 10px;
    border-radius: 6px;
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 150ms ease-out;
  }
  .nav-link:hover,
  .nav-link[aria-current] {
    color: var(--text);
  }
  .nav-link[aria-current] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .scroll-progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
</style>
