---
// Click-to-load YouTube facade: shows the poster; the youtube-nocookie iframe loads only on click.
// Without JavaScript the facade is a plain link to the video on YouTube.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { Play } from "lucide-react";
import { copy } from "../../data/profile";
import { youtubeEmbedUrl, youtubeId, youtubeWatchUrl } from "../../lib/video";

interface Props {
  video: string | undefined;
  poster: ImageMetadata | undefined;
  title: string;
}

const { video, poster, title } = Astro.props;
const id = youtubeId(video);
---

<div class="video relative aspect-video overflow-hidden rounded-xl border border-border bg-bg">
  {poster && (
    <Image
      src={poster}
      alt=""
      widths={[480, 800, 1280]}
      sizes="(min-width: 1168px) 1072px, calc(100vw - 48px)"
      class="absolute inset-0 h-full w-full object-cover"
    />
  )}
  {id ? (
    <a
      href={youtubeWatchUrl(id)}
      class="video-facade group absolute inset-0 flex items-center justify-center"
      data-embed={youtubeEmbedUrl(id)}
      data-title={title}
      aria-label={`${copy.featured.playVideo}: ${title}`}
    >
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-accent text-accent-contrast shadow-lg transition-transform duration-150 group-hover:scale-105">
        <Play size={28} fill="currentColor" aria-hidden="true" />
      </span>
    </a>
  ) : (
    <p class="text-mono absolute inset-x-0 bottom-0 m-0 max-w-none bg-black/60 px-4 py-2 text-center text-white">
      {copy.featured.videoComingSoon}
    </p>
  )}
</div>

<script>
  for (const facade of document.querySelectorAll<HTMLAnchorElement>(".video-facade")) {
    facade.addEventListener("click", (event) => {
      const src = facade.dataset.embed;
      if (!src) return;
      event.preventDefault();
      const iframe = document.createElement("iframe");
      iframe.src = src;
      iframe.title = facade.dataset.title ?? "Video";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 h-full w-full border-0";
      facade.replaceWith(iframe);
      iframe.focus();
    });
  }
</script>
