---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import FeaturedProject from "../components/sections/FeaturedProject.astro";
import Projects from "../components/sections/Projects.astro";
import Experience from "../components/sections/Experience.astro";
import Skills from "../components/sections/Skills.astro";
import Writing from "../components/sections/Writing.astro";
import Contact from "../components/sections/Contact.astro";
import { profile } from "../data/profile";
import { getProjects } from "../lib/projects";
import { getHomeSections, type HomeSection } from "../lib/sections";

const projects = await getProjects();
const featured = projects.find((project) => project.data.featured);
const others = projects.filter((project) => project !== featured);

const posts = (await getCollection("posts", (post) => !post.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Section numbers for the "// 01. about" labels, skipping sections that are not shown.
const sections = await getHomeSections();
const n = (id: HomeSection["id"]) => sections.findIndex((section) => section.id === id) + 1;

// Structured data for search engines (schema.org Person).
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.experience[0]?.title ?? profile.headline,
  description: profile.tagline,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  address: { "@type": "PostalAddress", addressLocality: profile.location },
  sameAs: [
    profile.links.github,
    profile.links.linkedin,
    ...(profile.links.others ?? []).map((l) => l.url),
  ],
  alumniOf: (profile.education ?? []).map((e) => ({
    "@type": "CollegeOrUniversity",
    name: e.school,
  })),
  knowsAbout: profile.skills.flatMap((skill) => skill.items),
};
---

<BaseLayout title={`${profile.name} · ${profile.headline}`} description={profile.tagline}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />
  <Hero featuredTitle={featured?.data.title} />
  <About index={n("about")} />
  {featured && <FeaturedProject index={n("featured")} project={featured} />}
  <Projects index={n("projects")} projects={others} />
  <Experience index={n("experience")} />
  <Skills index={n("skills")} />
  {posts.length > 0 && <Writing index={n("writing")} posts={posts} />}
  <Contact index={n("contact")} />
</BaseLayout>
