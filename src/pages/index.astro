---
// Step 2 layout preview; the real sections replace this in Step 3.
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { navLinks } from "../lib/nav";
---

<BaseLayout title={`${profile.name} · ${profile.headline}`} description={profile.tagline}>
  <section class="section container-page">
    <h1 class="text-display">{profile.name}</h1>
    <p class="mt-4 text-muted">{profile.headline}</p>
  </section>
  {navLinks.map((link, i) => (
    <section id={link.id} class="section container-page min-h-[60vh] border-t border-border">
      <p class="section-label">
        // {String(i + 1).padStart(2, "0")}. {link.id}
      </p>
      <h2>{link.label}</h2>
      <div class="card card-hover mt-6 p-6">
        <p class="text-muted">Section content arrives in Step 3.</p>
      </div>
    </section>
  ))}
</BaseLayout>
